# Copy to .env — docker compose reads it automatically.

# Warcraft Logs API v2 client (https://www.warcraftlogs.com/api/clients/).
# The registration form insists on a redirect URL. It belongs to the user-login
# flow, which Parsedle does not use — register any URL you control and it will
# never be visited, e.g.
#   https://parsedle.example.com/oauth/callback
#   http://localhost:8080/oauth/callback     (local testing)
# Without these credentials the game falls back to the bundled sample pool.
WCL_CLIENT_ID=
WCL_CLIENT_SECRET=

# Only members of this guild are ever the answer. Name + realm slug + region,
# or GUILD_ID if you know it (the number in the guild's Warcraft Logs URL).
GUILD_NAME=LuckyDo
GUILD_SERVER=
GUILD_REGION=
# GUILD_ID=

# Guards the report list and the roster: /api/reports, /api/roster and the
# /admin.html page. Generate one with: openssl rand -hex 32
ADMIN_TOKEN=

# Host port to publish (the container always listens on 8080).
PORT=8080

# ---------------------------------------------------------------- Discord --
# Where the game lives, publicly. Used for the OAuth redirect and the
# "Play now!" button.
PUBLIC_URL=https://parsedle.example.com

# Sign-in. All three are needed together or login stays off.
# App: https://discord.com/developers/applications
#   OAuth2 -> Redirects -> add  <PUBLIC_URL>/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Signs session cookies. Changing it signs everybody out.
#   openssl rand -hex 32
SESSION_SECRET=

# Posting. Both are needed together, or nothing is posted.
#   Bot -> Token, then invite it with Send Messages on the channel.
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# Optional: refuse logins from outside this server (needs DISCORD_GUILD_ID).
DISCORD_GUILD_ID=
DISCORD_REQUIRE_GUILD_MEMBER=

# When yesterday's scoreboard goes out, in UTC, and how it looks.
DISCORD_DIGEST_HOUR=10
DISCORD_DIGEST_GRIDS=
DISCORD_STREAK_MIN_PLAYERS=1

# Set to 1 only for plain-http local development: browsers refuse a Secure
# cookie over http://localhost.
INSECURE_COOKIES=
