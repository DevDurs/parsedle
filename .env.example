# Copy to .env — docker compose reads it automatically.

# Warcraft Logs API v2 client (https://www.warcraftlogs.com/api/clients/).
# Without these the game falls back to the bundled sample pool.
WCL_CLIENT_ID=
WCL_CLIENT_SECRET=

# Guards the report list: POST /api/reports and the /admin.html page.
# Generate one with: openssl rand -hex 32
ADMIN_TOKEN=

# Host port to publish (the container always listens on 8080).
PORT=8080
